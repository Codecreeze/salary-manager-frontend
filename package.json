{
  "name": "salary-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "check": "npm run type-check && npm run lint && npm run test && npm run build",
    "pretty": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-data-grid": "^7.29.13",
    "@mui/x-date-pickers": "^9.14.0",
    "@reduxjs/toolkit": "^2.12.0",
    "date-fns": "^4.4.0",
    "motion": "^13.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
